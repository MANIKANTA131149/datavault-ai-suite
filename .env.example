# API server (Render, App Runner, EB, EC2 — not Amplify)
MONGODB_URI=""
JWT_SECRET=replace-with-a-long-random-secret
FRONTEND_URL=http://localhost:8080
PORT=3001
KEEP_ALIVE_ENABLED=true
KEEP_ALIVE_URL=http://localhost:3001/api/health

# Frontend build-time (Amplify Environment variables, or local .env)
VITE_API_URL=http://localhost:3001/api
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_API_ENCRYPTION_KEY=

# ─── Cashfree Payments (server-only secrets) ──────────────────────────────────
# Get these from Cashfree Dashboard → Developers → API Keys.
# CASHFREE_ENV controls which Cashfree environment is used: "sandbox" or "production".
CASHFREE_ENV=sandbox
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# Optional: explicit public URL Cashfree should POST webhooks to. If unset we
# derive it from the incoming request host. Set this behind API Gateway/Lambda.
# Example: https://api.querify.in
PUBLIC_API_URL=



